# /etc/localtranslater.env  (chmod 600, owned by root)
# After editing: sudo systemctl restart localtranslater

# Address and port the web UI listens on. 0.0.0.0 = reachable from the LAN.
LT_HOST=0.0.0.0
LT_PORT=8000

# Login password (required). Changing it logs out every device.
LT_PASSWORD=change-me
# Random key for signing login cookies. Generate with: openssl rand -hex 32
LT_SECRET_KEY=
# How long a login stays valid, in days.
LT_SESSION_DAYS=30

# Ollama
LT_OLLAMA_URL=http://127.0.0.1:11434
LT_MODEL=gemma4:26b
# Translations sent to Ollama at the same time; others wait in line.
# Keep it <= OLLAMA_NUM_PARALLEL of the Ollama service.
LT_MAX_CONCURRENT=3
# Context window (tokens). Must fit system prompt + input + output.
LT_NUM_CTX=32768
LT_TEMPERATURE=0.2
# Thinking mode: leave empty for the model default, or set true/false.
LT_THINK=
# How long Ollama keeps the model loaded after the last request.
LT_KEEP_ALIVE=30m
# Seconds before a translation is abandoned.
LT_REQUEST_TIMEOUT=600

# Limits
LT_MAX_INPUT_CHARS=20000
LT_MAX_INSTRUCTION_CHARS=1000
